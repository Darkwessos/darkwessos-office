{
  "name": "darkwessos-office",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --test-isolation=none tests/storage.test.ts && node --import tsx --test --test-isolation=none tests/cockpit.test.ts && node --test --test-isolation=none tests/legacy/engine.test.cjs && npm run test:native",
    "build:native": "tsc --noEmit && vite build --mode native",
    "android:prepare": "npm run build:native && node scripts/prepare-android.mjs",
    "android:debug": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "test:native": "node --test --test-isolation=none tests/native.test.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/mantine": "0.57.0",
    "@blocknote/react": "0.57.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@capacitor/core": "7.0.0",
    "@capacitor/android": "7.0.0",
    "@capacitor/app": "7.0.0",
    "@capacitor/filesystem": "7.0.0",
    "@capacitor/share": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "@capacitor/cli": "7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
